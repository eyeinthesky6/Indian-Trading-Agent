{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ita/level1_policy.schema.json",
  "title": "ITA Level 1 Policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "version"],
  "properties": {
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "default_sessions": {"type": "integer", "minimum": 2},
    "min_sessions": {"type": "integer", "minimum": 2},
    "max_eod_age_days": {"type": "integer", "minimum": 0},
    "fast_period": {"type": "integer", "minimum": 1},
    "slow_period": {"type": "integer", "minimum": 2},
    "rsi_period": {"type": "integer", "minimum": 1},
    "atr_period": {"type": "integer", "minimum": 1},
    "max_atr_pct": {"type": "number", "exclusiveMinimum": 0},
    "max_rsi_new_long": {"type": "number", "minimum": 0, "maximum": 100},
    "min_volume_ratio": {"type": "number", "minimum": 0},
    "breakout_near_high_ratio": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
    "breakout_buffer_atr": {"type": "number", "minimum": 0},
    "breakout_buffer_pct": {"type": "number", "minimum": 0},
    "breakout_stop_atr": {"type": "number", "minimum": 0},
    "breakout_sma_stop_atr": {"type": "number", "minimum": 0},
    "pullback_band_atr": {"type": "number", "minimum": 0},
    "pullback_stop_atr": {"type": "number", "minimum": 0},
    "pullback_low_stop_atr": {"type": "number", "minimum": 0},
    "reclaim_band_atr": {"type": "number", "minimum": 0},
    "reclaim_stop_atr": {"type": "number", "minimum": 0},
    "range_stop_atr": {"type": "number", "minimum": 0},
    "chase_limit_atr": {"type": "number", "minimum": 0},
    "target_r_multiples": {"type": "array", "minItems": 1, "items": {"type": "number", "exclusiveMinimum": 0}},
    "min_reward_to_risk": {"type": "number", "minimum": 0},
    "default_risk_fraction": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
    "default_max_position_fraction": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}
  }
}
